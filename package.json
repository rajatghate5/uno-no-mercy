{
  "name": "uno-no-mercy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "play": "bun run packages/tui/src/main.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/tui/tsconfig.json",
    "sim": "bun run packages/engine/test/simulate.ts",
    "bench": "bun run packages/engine/test/benchmark.ts",
    "snapshot": "bun run packages/tui/test/snapshot.tsx",
    "build": "bun run scripts/build.ts",
    "serve": "bun run packages/server/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.2"
  }
}
