{
  "name": "uno-no-mercy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @uno/web dev",
    "serve": "bun run packages/server/src/main.ts",
    "build": "bun --filter @uno/web build",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web/tsconfig.json",
    "sim": "bun run packages/engine/test/simulate.ts",
    "bench": "bun run packages/engine/test/benchmark.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.2"
  }
}
