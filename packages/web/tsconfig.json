{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "bundler"
  },
  // Reset the inherited exclude: the root excludes packages/web so it does not
  // typecheck browser code without lib.dom, but that must not exclude us from
  // ourselves.
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
